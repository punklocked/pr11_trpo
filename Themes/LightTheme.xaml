<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackground" Color="#F5FAFB"/>
    <SolidColorBrush x:Key="Background" Color="#F5FAFB"/>
    <SolidColorBrush x:Key="Foreground" Color="#444B54"/>

    <SolidColorBrush x:Key="TitleForeground" Color="#2E3B4E"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#6E7A89"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#378CE0"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#33B8B1"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#3A9AD9"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ButtonAddBackground" Color="#73d978"/>
    <SolidColorBrush x:Key="ButtonAddHover" Color="#3A9AD9"/>

    <SolidColorBrush x:Key="ButtonRemoveBackground" Color="#E65A4F"/>
    <SolidColorBrush x:Key="ButtonRemoveHover" Color="#3A9AD9"/>

    <SolidColorBrush x:Key="TextBoxBackground" Color="#F0F6F8"/>

    <SolidColorBrush x:Key="MenuItemHoverBackground" Color="Gray"/>
    <SolidColorBrush x:Key="MenuItemHoverForeground" Color="Black"/>

    <SolidColorBrush x:Key="ValidationErrorBackground" Color="#FFE8E8"/>
    <SolidColorBrush x:Key="ValidationErrorText" Color="#444B54"/>
    <SolidColorBrush x:Key="ValidationErrorBorder" Color="#D93025"/>

</ResourceDictionary>