<Page x:Class="pract8_trpo.Pages.AppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract8_trpo.Pages"
      xmlns:converters="clr-namespace:pract8_trpo.Data.Converters"
      xmlns:validators="clr-namespace:pract8_trpo.Data.Validators"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentPage">

    <Page.Resources>
        <converters:AgeConverter x:Key="ageConverter"/>
        <converters:AppointmentConverter x:Key="appointmentConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <Button Content="Назад" Click="BackButton_Click" Style="{DynamicResource BackButton}" DockPanel.Dock="Top"></Button>
            <StackPanel Style="{StaticResource VerticalPanel}">
                <StackPanel>
                    <StackPanel DockPanel.Dock="Right" Style="{StaticResource HorizontalPanel}">
                        <StackPanel>
                            <Label Content="Имя: "></Label>
                            <Label Content="Фамилия: "></Label>
                            <Label Content="Отчество: "></Label>
                            <Label Content="Возраст: "></Label>
                            <Label Content="Последний врач: "></Label>
                            <Label Content="Дата рождения"></Label>
                        </StackPanel>
                        <StackPanel>
                            <Label Content="{Binding Name}"></Label>
                            <Label Content="{Binding LastName}"></Label>
                            <Label Content="{Binding MiddleName}"></Label>
                            <Label Content="{Binding Birthday, Converter={StaticResource ageConverter}, UpdateSourceTrigger=PropertyChanged}"></Label>
                            <Label Content="{Binding LastDoctorName}"></Label>
                            <TextBlock Style="{DynamicResource BlockDate}" Text="{Binding Birthday, StringFormat={}{0:dd.MM.yyyy}}"></TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <Label Content="Диагноз:"></Label>
                        <TextBox x:Name="TextBoxDiagnosis">
                            <TextBox.Text>
                                <Binding Path="Diagnosis" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validators:StringValidation/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <ItemsControl Style="{StaticResource ErrorText}" ItemsSource="{Binding ElementName=TextBoxDiagnosis, Path=(Validation.Errors)}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorContent}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel>
                        <Label Content="Рекомендации: "></Label>
                        <TextBox x:Name="TextBoxRecomendations"
                                 Style="{StaticResource BigTextBox}">
                            <TextBox.Text>
                                <Binding Path="Recommendations" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validators:StringValidation/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <ItemsControl Style="{StaticResource ErrorText}" ItemsSource="{Binding ElementName=TextBoxRecomendations, Path=(Validation.Errors)}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorContent}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource VerticalPanel}">
                    <Label Content="{Binding AppointmentStories, Converter={StaticResource appointmentConverter}, UpdateSourceTrigger=PropertyChanged}"></Label>
                </StackPanel>
                <StackPanel>
                    <Button Name="EditPatient" Content="Закончить приём" Click="EditPatient_Click"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Column="1">
            <Label Content="История приёмов: "></Label>
            <ListView
                ItemsSource="{Binding AppointmentStories}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Style="{StaticResource HorizontalPanel}">
                                <TextBlock Text="Дата: "></TextBlock>
                                <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}"></TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HorizontalPanel}">
                                <TextBlock Text="ID доктора: "></TextBlock>
                                <TextBlock Text="{Binding Doctor_ID}"></TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HorizontalPanel}">
                                <TextBlock Text="Диагноз: "></TextBlock>
                                <TextBlock Text="{Binding Diagnosis}"></TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HorizontalPanel}">
                                <TextBlock Text="Рекомендации: "></TextBlock>
                                <TextBlock Text="{Binding Recommendations}"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
