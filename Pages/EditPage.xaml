<Page x:Class="pract8_trpo.Pages.EditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract8_trpo.Pages"
      xmlns:validators="clr-namespace:pract8_trpo.Data.Validators"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditPage">

    <DockPanel>
        <Button Style="{DynamicResource BackButton}" Content="Назад" Click="BackButton_Click" DockPanel.Dock="Top"></Button>
        <StackPanel Style="{StaticResource VerticalPanel}">
            <StackPanel x:Name="EditPatientForm">

                <StackPanel>
                    <Label Content="Имя: "></Label>
                    <TextBox x:Name="TextBoxName">
                        <TextBox.Text>
                            <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:StringValidation/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <ItemsControl Style="{StaticResource ErrorText}" ItemsSource="{Binding ElementName=TextBoxName, Path=(Validation.Errors)}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorContent}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel>
                    <Label Content="Фамилия: "></Label>
                    <TextBox x:Name="TextBoxLastName">
                        <TextBox.Text>
                            <Binding Path="LastName" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:StringValidation/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <ItemsControl Style="{StaticResource ErrorText}" ItemsSource="{Binding ElementName=TextBoxLastName, Path=(Validation.Errors)}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorContent}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel>
                    <Label Content="Отчество: "></Label>
                    <TextBox x:Name="TextBoxMiddleName">
                        <TextBox.Text>
                            <Binding Path="MiddleName" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:StringValidation/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <ItemsControl Style="{StaticResource ErrorText}" ItemsSource="{Binding ElementName=TextBoxMiddleName, Path=(Validation.Errors)}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorContent}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel>
                    <Label Content="Номер телефона"></Label>
                    <TextBox x:Name="TextBoxPhone">
                        <TextBox.Text>
                            <Binding Path="PhoneNumber" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:PhoneValidation/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <ItemsControl Style="{StaticResource ErrorText}" ItemsSource="{Binding ElementName=TextBoxPhone, Path=(Validation.Errors)}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorContent}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel>
                    <Label Content="Дата рождения"></Label>
                    <DatePicker x:Name="BirthdayPicker">
                        <DatePicker.SelectedDate>
                            <Binding Path="Birthday" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:DateValidation/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DatePicker.SelectedDate>
                    </DatePicker>
                    <ItemsControl Style="{StaticResource ErrorText}" ItemsSource="{Binding ElementName=BirthdayPicker, Path=(Validation.Errors)}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorContent}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Content="Изменить" Name="Edit" Click="EditPatient_Click"/>
                <Button Content="Сбросить" Name="Reset" Click="Reset_Click"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Page>
