<Window x:Class="pract8_trpo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract8_trpo"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="800">
    <DockPanel Style="{DynamicResource MainPanel}">

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Меню" Style="{DynamicResource MenuMain}">
                <MenuItem Header="Настройки">
                    <MenuItem Header="Сменить тему" Click="MenuItem_Click"></MenuItem>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" DockPanel.Dock="Top" VerticalAlignment="Top"></Frame>

        <StackPanel Style="{StaticResource InfoPanel}" DockPanel.Dock="Bottom" Background="Gray" Height="50" VerticalAlignment="Bottom" Orientation="Horizontal">
            <StackPanel Style="{StaticResource InfoPanelItem}" Orientation="Horizontal">
                <Label Content="Количество файлов: "></Label>
                <Label Content="{Binding JSONFiles}"></Label>
            </StackPanel>
            <StackPanel Style="{StaticResource InfoPanelItem}" Orientation="Horizontal">
                <Label Content="Количество врачей: "></Label>
                <Label Content="{Binding Doctors}"></Label>
            </StackPanel>
            <StackPanel Style="{StaticResource InfoPanelItem}" Orientation="Horizontal">
                <Label Content="Количество пациентов: "></Label>
                <Label Content="{Binding Patients}"></Label>
            </StackPanel>
        </StackPanel>

    </DockPanel>
</Window>
